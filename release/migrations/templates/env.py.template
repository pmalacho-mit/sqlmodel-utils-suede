"""Alembic environment.

Everything generic -- async engine setup, resolving the database url, the
autogenerate comparison options, and the render hooks that keep this project's
column types importable from migration files -- lives in `__PACKAGE__.migrations`.
Keyword arguments to `run_migrations` override any of it.
"""

from __PACKAGE__.migrations import run_migrations
from __PACKAGE__.postgres.metadata import Base

# Imported for the side effect of defining every table on `Base.metadata`.
# Autogenerate compares the database against whatever is registered *now*, so a
# model whose module is never imported here reads as a table to be dropped.
import __MODELS__  # noqa: F401

run_migrations(target_metadata=Base.metadata)
